{
    "author": "mrz1836",
    "description": "A sophisticated statistical analysis tool for NC Lucky for Life lottery data that combines traditional statistical methods with cosmic correlation analysis.",
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.10",
        "jsdom": "^30.0.1",
        "serve": "^14.2.6",
        "vitest": "^4.1.10"
    },
    "homepage": "https://github.com/mrz1836/go-lucky#readme",
    "keywords": [
        "lottery",
        "analysis",
        "statistics",
        "cosmic",
        "correlation",
        "nc-lucky-for-life"
    ],
    "license": "MIT",
    "main": "web-assets/index.html",
    "name": "go-lucky-lottery-analyzer",
    "overrides": {
        "brace-expansion": "1.1.18",
        "nanoid": "3.3.18",
        "on-headers": "1.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mrz1836/go-lucky.git"
    },
    "scripts": {
        "build": "echo 'Building static site...' && cp -r . dist/ 2>/dev/null || true",
        "dev": "npx serve web-assets -p 3000",
        "start": "npx serve web-assets -p 3000",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "version": "1.0.0"
}
